# SomaBrain Environment Configuration
# Copy this file to .env and customize for your environment.
#
# VIBE secret contract: Vault owns every secret. ENV carries system
# configuration / platform topology ONLY — hosts, ports, URLs, modes, flags.
# No user credentials. No DB passwords. No DSNs. No keys. No tokens.
#
# A blank `VAR=` is deliberately never written here: it invites a paste-and-push.
# Each secret below names its Vault path instead.

# Circuit breaker settings
SOMABRAIN_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SOMABRAIN_CIRCUIT_BREAKER_RESET_INTERVAL=60.0
SOMABRAIN_CIRCUIT_BREAKER_COOLDOWN_PERIOD=5.0

# Outbox settings
SOMABRAIN_OUTBOX_DEFAULT_LIMIT=100
SOMABRAIN_OUTBOX_MAX_LIMIT=1000
SOMABRAIN_OUTBOX_TENANT_BATCH_LIMIT=50
SOMABRAIN_OUTBOX_MAX_RETRIES=5

# Memory service settings
EMBED_DIM=768
SOMABRAIN_MEMORY_HRR_DIM=8192
SOMABRAIN_MEMORY_API_TIMEOUT=90
SOMABRAIN_MEMORY_DB_TIMEOUT=30

# Rate limiting
SOMABRAIN_RATE_RPS=100000
SOMABRAIN_RATE_BURST=100000
SOMABRAIN_WRITE_DAILY_LIMIT=100000000

# Planning
SOMABRAIN_PLAN_MAX_STEPS=5
SOMABRAIN_PREDICTOR_TIMEOUT_MS=250

# MinIO object storage (used by SFM) — credentials are NOT environment variables.
#   MINIO_ACCESS_KEY is read from Vault at runtime: secret/agent/credentials/minio_access_key
#   MINIO_SECRET_KEY is read from Vault at runtime: secret/agent/credentials/minio_secret_key
# Fail-closed: if Vault is unreachable the object-storage client does not start.
