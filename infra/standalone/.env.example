# SomaBrain Standalone - Environment Configuration
# Copy this file to .env before starting: cp .env.example .env
#
# VIBE secret contract: Vault owns every secret. ENV carries system
# configuration / platform topology ONLY — hosts, ports, URLs, modes, flags.
# No user credentials. No DB passwords. No DSNs. No keys. No tokens.
#
# Every secret below names its Vault path. There is deliberately NO blank
# `VAR=` and no `change-me` in this file: either one invites a paste-and-push,
# and a root token committed to git is a root credential in git.

# --- Security ---------------------------------------------------------------
# Root token for Vault initialization.
# SOMABRAIN_VAULT_TOKEN is NEVER set here. The bootstrap token is injected at
# runtime from the deployer's process environment or Docker secret.

# Password for the PostgreSQL database user 'somabrain'.
# POSTGRES_PASSWORD is read from Vault at runtime:
#   secret/agent/credentials/postgres_password
# No DSN in ENV — a DSN embeds the password. Build it from host/port/user/db.

# JWT signing secret seeded into Vault on first bootstrap.
# SOMABRAIN_JWT_SECRET is read from Vault at runtime:
#   secret/agent/credentials/somabrain_jwt_secret

# Bootstrap-only secret used by `vault_init` to seed Vault.
# The running app fetches the token from Vault and does not read this value.
# SOMABRAIN_MEMORY_HTTP_TOKEN is read from Vault at runtime:
#   secret/agent/credentials/somabrain_memory_http_token

# Bootstrap-only secret used by `vault_init` to seed Vault.
# The running cog container fetches it from Vault before launching supervisord.
# SUPERVISOR_HTTP_PASS is read from Vault at runtime:
#   secret/agent/credentials/supervisor_http_pass

# MinIO root credentials.
# MINIO_ACCESS_KEY is read from Vault at runtime: secret/agent/credentials/minio_access_key
# MINIO_SECRET_KEY is read from Vault at runtime: secret/agent/credentials/minio_secret_key

# --- Connectivity -----------------------------------------------------------
# Host/Port for the main API service.
SOMABRAIN_HOST=0.0.0.0
SOMABRAIN_PORT=30101

# Host headers allowed by Django. Must include localhost for healthchecks and
# host.docker.internal for Docker Desktop proxy requests.
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,somabrain,somabrain-app

# Memory Service (SFM) Access
# In standalone Docker mode, this defaults to host.docker.internal:10101
# Override only if using a custom networking setup.
# SOMABRAIN_MEMORY_HTTP_ENDPOINT=http://host.docker.internal:10101

# --- Feature Flags ----------------------------------------------------------
# Run mode: dev, staging, or production
SOMABRAIN_MODE=dev

# Workers configuration
SOMABRAIN_WORKERS=1

# External dependency flags (0=disable, 1=enable)
SOMABRAIN_REQUIRE_EXTERNAL_BACKENDS=1
SOMABRAIN_REQUIRE_MEMORY=1
SOMABRAIN_FORCE_FULL_STACK=1

# --- Full-potential enablement matrix ---------------------------------------
# Matches config/env.example. Compose passes these through to app and cog as
# required keys (${VAR:?set VAR}); code defaults stay fail-closed so a missing
# value is a refusal naming the key. Keep SOMABRAIN_KILL_SWITCH=0 (safety).
ENABLE_OAK=1
OAK_OPTION_MODEL_MANAGED=1
SOMABRAIN_USE_PLANNER=1
SOMABRAIN_USE_EXEC_CONTROLLER=1
SOMABRAIN_USE_META_BRAIN=1
SOMABRAIN_USE_HRR=1
SOMABRAIN_USE_HRR_FIRST=1
SOMABRAIN_USE_MICROCIRCUITS=1
SOMABRAIN_USE_SOFT_SALIENCE=1
SOMABRAIN_USE_SDR_PREFILTER=1
SOMABRAIN_USE_GRAPH_AUGMENT=1
SOMABRAIN_USE_DRIFT_MONITOR=1
SOMABRAIN_ENTROPY_CAP_ENABLED=1
SOMABRAIN_LEARNING_RATE_DYNAMIC=1
SOMABRAIN_LEARNING_LOOP_ENABLED=1
CALIBRATION_ENABLED=1
SOMABRAIN_MEMORY_ENABLE_WEIGHTING=1
SOMABRAIN_MEMORY_FAST_ACK=1
REQUIRE_OPA=1
SOMABRAIN_REQUIRE_PROVENANCE=1
SOMABRAIN_PROVENANCE_STRICT_DENY=1
SOMABRAIN_KILL_SWITCH=0

# --- Service topology (L3) ---------------------------------------------------
# Hosts, ports and URLs. Never a secret value -- credentials come from Vault via
# the *_FILE paths above. Compose requires each of these and refuses to start
# without them (${VAR:?set VAR}); there is no default.
#
# In-network DNS names on the standalone compose networks. Override for your
# deployment. A URL a caller invents is a URL an operator cannot change and a
# reviewer cannot see (VIBE Rule 1).

# Object storage and schema registry
MINIO_ENDPOINT=http://minio:9000
SCHEMA_REGISTRY_URL=http://somabrain_standalone_schema_registry:8081

# Vector store for OAK. The brain rides the SomaFractalMemory stack's Milvus;
# there is no brain-local Milvus service in this compose file.
# ENABLE_OAK is set once in the Full-potential enablement matrix above.
SOMABRAIN_MILVUS_HOST=somafractalmemory-standalone-milvus
SOMABRAIN_MILVUS_PORT=19530

# Kafka bootstrap, for the app and outbox_publisher (not only the integrator)
KAFKA_BOOTSTRAP_SERVERS=somabrain_standalone_kafka:9092
